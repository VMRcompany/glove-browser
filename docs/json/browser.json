  "proxy": {
    "enabled": true,
    "readers": [
      "https://r.jina.ai/",
      "https://api.allorigins.win/raw?url="
    ]
  },
  "features": {
    "weather": false,
    "adaptive_ui": true,
    "keypad": true,
    "touch": true
  }
}
