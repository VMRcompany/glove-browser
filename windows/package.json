{
  "name": "glove-browser",
  "productName": "Glove Browser",
  "version": "1.8.5",
  "description": "Glove Browser",
  "author": "Glove Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:legacy": "electron-builder --win nsis --ia32 -c.productName=\"Glove Browser Legacy\" -c.win.artifactName=GloveBrowser-Legacy-Setup.${ext} -c.nsis.shortcutName=\"Glove Browser Legacy\""
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "pro.mineholde.glove",
    "productName": "Glove Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "page-preload.js",
      "extensions.js",
      "engines.js",
      "vault.js",
      "voice.js",
      "weather.js",
      "permissions.js",
      "index.html",
      "renderer.js",
      "style.css",
      "logo.png",
      "logo.ico",
      "engines/**/*"
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "GloveBrowser-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glove Browser",
      "unicode": true,
      "installerLanguages": ["ru_RU", "en_US"]
    }
  }
}
